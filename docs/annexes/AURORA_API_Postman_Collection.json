    {
      "name": "06. Rubrics, Consensus Scoring & Digital Signatures (R.A. 8792)",
      "item": [
        {
          "name": "GET Retrieve Active Defense Rubric Criteria",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{supabase_url}}/rest/v1/rubric_templates?program=eq.BSIT&is_active=eq.true&select=id,title,criteria,thresholds",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "rubric_templates"],
              "query": [
                { "key": "program", "value": "eq.BSIT" },
                { "key": "is_active", "value": "eq.true" },
                { "key": "select", "value": "id,title,criteria,thresholds" }
              ]
            },
            "description": "Loads institutional rubric weights (e.g., Technical Quality 30%, System Demo 35%, Oral Defense 25%, Manuscript Adherence 10%)."
          }
        },
        {
          "name": "POST Submit Scored Evaluation with Step-Up Signature (RPC)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"p_evaluation_id\": \"a892b110-4491-419b-b912-3849102938cd\",\n  \"p_scores\": {\n    \"technical_soundness\": 92.5,\n    \"software_execution\": 95.0,\n    \"defense_presentation\": 90.0,\n    \"manuscript_compliance\": 94.0\n  },\n  \"p_verdict_code\": \"approved\",\n  \"p_panel_notes\": \"Exceptional engineering execution and thorough adherence to ParSU defense guidelines.\",\n  \"p_recommendations\": \"Proceed with final institutional manuscript binding.\",\n  \"p_signature_image\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAA...\",\n  \"p_password_hash_proof\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/rest/v1/rpc/submit_signed_evaluation",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "rpc", "submit_signed_evaluation"]
            },
            "description": "Commits individual panelist scores and affixes legal electronic signature under R.A. 8792 compliance with atomic lock state."
          }
        },
        {
          "name": "POST Finalize Consensus Deliberation & Issue Serial (RPC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Consensus computed and Certificate Issued\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('certificate_serial');",
                  "    pm.collectionVariables.set(\"certificate_serial\", json.certificate_serial);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"p_project_id\": \"{{project_id}}\",\n  \"p_stage_id\": \"f1023844-3829-410a-9bc2-3849102938ab\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/rest/v1/rpc/finalize_defense_consensus",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "rpc", "finalize_defense_consensus"]
            },
            "description": "Calculates weighted aggregate score across all 3 panelists, validates majority/unanimous verdict, locks the stage, and assigns the unique sequence serial."
          }
        }
      ]
    },
    {
      "name": "07. Public Verification & Institutional Audit",
      "item": [
        {
          "name": "GET Public Certificate Verification JSON API",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
