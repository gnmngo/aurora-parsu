  "item": [
    {
      "name": "01. Authentication & Session Management",
      "item": [
        {
          "name": "POST Sign In with Institutional Credentials (JWT Exchange)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 (Login Successful)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set(\"auth_token\", jsonData.access_token);",
                  "    pm.test(\"JWT Access Token captured successfully\", function () {",
                  "        pm.expect(jsonData.access_token).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_anon_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"froiland.penalosa@parsu.edu.ph\",\n  \"password\": \"Demo1234!\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
              "host": ["{{supabase_url}}"],
              "path": ["auth", "v1", "token"],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "description": "Authenticates a faculty, student, or administrator using institutional credentials and returns an HTTP JWT bearer token along with user profile metadata."
          }
        },
        {
          "name": "GET Retrieve Active User Session & Roles",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"User email belongs to ParSU domain\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.email).to.include(\"@parsu.edu.ph\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_anon_key}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{supabase_url}}/auth/v1/user",
              "host": ["{{supabase_url}}"],
              "path": ["auth", "v1", "user"]
            },
            "description": "Retrieves the currently authenticated user's session claims, UUID, email, and user role grants."
          }
        },
        {
          "name": "POST Sign Out / Revoke Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_anon_key}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{supabase_url}}/auth/v1/logout",
              "host": ["{{supabase_url}}"],
              "path": ["auth", "v1", "logout"]
            },
            "description": "Terminates active session and invalidates refresh token at the GoTrue authentication gateway."
          }
        }
